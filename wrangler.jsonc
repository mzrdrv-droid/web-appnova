{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appnova",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "a504b10d-6a14-4a24-b1ea-b20255f98349","database_name": "web-appnova" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "75261888430046c1aa764332d40c2741" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
